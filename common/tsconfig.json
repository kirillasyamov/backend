{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": ".",
		"composite": true,
		"paths": {
			"@/*": ["./modules/*", "./utils/*", "./contracts/*"]
		},
		"tsBuildInfoFile": "./dist/.tsbuildinfo"
	},
	"include": ["modules/**/*", "utils/**/*", "contracts/**/*", "configs/**/*"]
}
