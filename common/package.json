{
	"name": "@kirillasyamov/common",
	"version": "3.0.13",
	"description": "Shared contracts, configs, modules and filters for the application",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"contracts/proto",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./configs": {
			"types": "./dist/configs/index.d.ts",
			"default": "./dist/configs/index.js"
		},
		"./filters": {
			"types": "./dist/filters/index.d.ts",
			"default": "./dist/filters/index.js"
		},
		"./utils": {
			"types": "./dist/utils/index.d.ts",
			"default": "./dist/utils/index.js"
		},
		"./modules/*": {
			"types": "./dist/modules/*.d.ts",
			"default": "./dist/modules/*.js"
		},
		"./enums/*": {
			"types": "./dist/enums/*.d.ts",
			"default": "./dist/enums/*.js"
		},
		"./contracts": {
			"types": "./dist/contracts/contracts.constants.d.ts",
			"default": "./dist/contracts/contracts.constants.js"
		},
		"./contracts/generated/*": {
			"types": "./dist/contracts/generated/*.d.ts",
			"default": "./dist/contracts/generated/*.js"
		},
		"./contracts/proto/*": "./contracts/proto/*",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsup && tsc -p tsconfig.build.json"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	},
	"keywords": [
		"nestjs",
		"grpc",
		"microservices",
		"prisma",
		"redis"
	],
	"author": "kirillasyamov",
	"license": "ISC",
	"dependencies": {
		"grpc-health-check": "^2.1.0",
		"ioredis": "^5.6.1",
		"joi": "^17.13.3"
	},
	"peerDependencies": {
		"@grpc/grpc-js": "^1.14.4",
		"@nestjs/common": "^11.1.27",
		"@nestjs/config": "^4.0.4",
		"@nestjs/core": "^11.1.27",
		"@nestjs/microservices": "^11.1.27",
		"@nestjs/swagger": "^11.4.6",
		"@prisma/client": "^7.0.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2"
	},
	"devDependencies": {
		"@grpc/grpc-js": "^1.14.4",
		"@nestjs/common": "^11.1.27",
		"@nestjs/config": "^4.0.4",
		"@nestjs/core": "^11.1.27",
		"@nestjs/microservices": "^11.1.27",
		"@nestjs/swagger": "^11.4.6",
		"@prisma/client": "^7.0.0",
		"@types/node": "^26.0.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"tsup": "^8.5.0",
		"typescript": "^6.0.3"
	}
}
