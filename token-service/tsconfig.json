{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": "src",
		"composite": true,
		"paths": {
			"@/*": ["./src/*"],
			"common/*": ["../common/*"]
		},
		"tsBuildInfoFile": "./dist/.tsbuildinfo"
	},
	"include": ["src/**/*"],
	"references": [{ "path": "../common" }]
}
