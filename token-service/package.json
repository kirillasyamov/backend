	"main": "index.js",
	"scripts": {
		"build": "tsc -b",
		"start": "node --import tsx dist/main.js",
		"start:dev": "cross-env PORT=3004 tsx watch src/main.ts",
		"start:debug": "cross-env PORT=3004 tsx watch --inspect src/main.ts",
		"start:prod": "node --import tsx dist/main.js",
		"lint": "eslint \"src/**/*.ts\"",
		"lint:fix": "eslint \"src/**/*.ts\" --fix",
		"format": "prettier --write \"src/**/*.ts\"",
		"format:check": "prettier --check \"src/**/*.ts\""
	},
	"keywords": [],
	"author": "kirillasyamov",
	"license": "ISC",
	"type": "module",
	"devDependencies": {
		"@types/node": "catalog:development",
