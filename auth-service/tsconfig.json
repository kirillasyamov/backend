{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": ".",
		"composite": true,
		"paths": {
			"@/*": ["./src/*"],
			"common/*": ["../common/*"]
		},
		"tsBuildInfoFile": "./dist/.tsbuildinfo"
	},
	"include": ["src/**/*", "prisma/**/*.ts", "../common/**/*"],
	"references": [{ "path": "../common" }]
}
