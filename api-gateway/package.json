{
	"name": "api-gateway",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"scripts": {
		"build": "tsc -b",
		"start": "cross-env NODE_ENV=production PORT=3001 node --import @swc-node/register/esm-register --enable-source-maps dist/main.js",
		"start:dev": "cross-env NODE_ENV=development PORT=3001 node --watch --import @swc-node/register/esm-register --enable-source-maps src/main.ts",
		"start:debug": "cross-env NODE_ENV=debug PORT=3001 node --watch --inspect --import @swc-node/register/esm-register --enable-source-maps src/main.ts",
		"start:prod": "cross-env NODE_ENV=production PORT=3001 node --import @swc-node/register/esm-register --enable-source-maps dist/main.js",
		"lint": "eslint \"src/**/*.ts\"",
		"lint:fix": "eslint \"src/**/*.ts\" --fix",
		"format": "prettier --write \"src/**/*.ts\"",
		"format:check": "prettier --check \"src/**/*.ts\""
	},
	"keywords": [],
	"author": "kirillasyamov",
	"license": "ISC",
	"type": "module",
	"dependencies": {
		"common": "workspace:*",
		"@grpc/grpc-js": "catalog:grpc",
		"@grpc/proto-loader": "catalog:grpc",
		"@nestjs/common": "catalog:nest",
		"@nestjs/config": "catalog:nest",
		"@nestjs/core": "catalog:nest",
		"@nestjs/microservices": "catalog:nest",
		"@nestjs/platform-fastify": "catalog:nest",
		"class-transformer": "catalog:validation",
		"class-validator": "catalog:validation",
		"reflect-metadata": "catalog:runtime",
		"rxjs": "catalog:runtime",
		"@nestjs/swagger": "catalog:nest",
		"@fastify/swagger": "catalog:nest",
		"@fastify/swagger-ui": "catalog:nest",
		"@nestjs/throttler": "catalog:nest"
	},
	"devDependencies": {
		"@swc/core": "catalog:development",
		"@swc-node/register": "catalog:development",
		"@types/node": "catalog:development",
		"cross-env": "catalog:development",
		"eslint": "catalog:development",
		"eslint-config-prettier": "catalog:development",
		"prettier": "catalog:development",
		"typescript": "catalog:development",
		"typescript-eslint": "catalog:development"
	}
}
