{
	"name": "user-service",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"scripts": {
		"build": "tsc -b",
		"start": "node --import @swc-node/register/esm-register --enable-source-maps dist/main.js",
		"start:dev": "cross-env PORT=3003 node --watch --import @swc-node/register/esm-register --enable-source-maps src/main.ts",
		"start:debug": "cross-env PORT=3003 node --watch --inspect --import @swc-node/register/esm-register --enable-source-maps src/main.ts",
		"start:prod": "node --import @swc-node/register/esm-register --enable-source-maps dist/main.js",
		"lint": "eslint \"src/**/*.ts\"",
		"lint:fix": "eslint \"src/**/*.ts\" --fix",
		"format": "prettier --write \"src/**/*.ts\"",
		"format:check": "prettier --check \"src/**/*.ts\""
	},
	"keywords": [],
	"author": "kirillasyamov",
	"license": "ISC",
	"type": "module",
	"devDependencies": {
		"@swc/core": "catalog:development",
		"@swc-node/register": "catalog:development",
		"@types/node": "catalog:development",
		"cross-env": "catalog:development",
		"eslint": "catalog:development",
		"eslint-config-prettier": "catalog:development",
		"prettier": "catalog:development",
		"typescript": "catalog:development",
		"typescript-eslint": "catalog:development"
	},
	"dependencies": {
		"dotenv": "catalog:config",
		"@grpc/grpc-js": "catalog:grpc",
		"@grpc/proto-loader": "catalog:grpc",
		"@nestjs/common": "catalog:nest",
		"@nestjs/config": "catalog:nest",
		"@nestjs/core": "catalog:nest",
		"@nestjs/microservices": "catalog:nest",
		"class-transformer": "catalog:validation",
		"class-validator": "catalog:validation",
		"prisma": "catalog:database",
		"@prisma/client": "catalog:database",
		"@prisma/adapter-pg": "catalog:database",
		"pg": "catalog:database",
		"reflect-metadata": "catalog:runtime",
		"rxjs": "catalog:runtime"
	}
}
