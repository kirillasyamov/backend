generator client {
  	provider = "prisma-client"
  	output = "generated"
  	moduleFormat = "esm"
}

datasource db {
  	provider = "postgresql"
}

model User {
	id String @id @default(nanoid())

	login String @unique @db.VarChar(100)
	email String @unique

	age Int @db.SmallInt
	bio String @db.VarChar(1000)

	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt
	deletedAt DateTime?

	@@map("user")
}

