generator client {
  	provider = "prisma-client"
  	output   = "generated"
  	moduleFormat = "esm"
}

datasource db {
  	provider = "postgresql"
}

model User {
	id String @id

	firstName String @db.VarChar(100) @map("first_name")
	lastName String @db.VarChar(100) @map("last_name")
	age Int? @db.SmallInt
	bio String? @db.VarChar(1000)

	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt
	deletedAt DateTime?

	@@map("user")
}

