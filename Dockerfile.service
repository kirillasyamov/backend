FROM node:22-alpine AS deps
WORKDIR /repo

ARG SERVICE

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY $SERVICE/ ./$SERVICE/

RUN corepack enable
RUN yq -i ".packages = [\"$SERVICE\"]" pnpm-workspace.yaml

RUN --mount=type=cache,target=/root/.local/share/pnpm/store/v11 \
    --mount=type=cache,target=/root/.cache/pnpm \
    pnpm install --frozen-lockfile --prefer-offline \
      --config.network-timeout=60000 --config.fetch-retries=2 \
      --filter $SERVICE

ENV DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

RUN if [ -f $SERVICE/prisma/schema.prisma ]; then pnpm --filter $SERVICE exec prisma generate; fi

FROM node:22-alpine AS builder
WORKDIR /repo

ARG SERVICE

RUN apk add --no-cache yq
RUN corepack enable

COPY --from=deps /repo/node_modules ./node_modules
COPY --from=deps /repo/pnpm-lock.yaml /repo/pnpm-lock.yaml
COPY --from=deps /repo/pnpm-workspace.yaml /repo/pnpm-workspace.yaml
COPY --from=deps /repo/package.json /repo/package.json
COPY --from=deps /repo/tsconfig.base.json /repo/tsconfig.base.json
COPY --from=deps /repo/$SERVICE /repo/$SERVICE

RUN yq -i ".packages = [\"$SERVICE\"]" pnpm-workspace.yaml

RUN pnpm --filter $SERVICE build

RUN --mount=type=cache,target=/root/.local/share/pnpm/store/v11 \
    --mount=type=cache,target=/root/.cache/pnpm \
    pnpm deploy --legacy --prefer-offline --filter=$SERVICE /deploy

COPY --chmod=0755 $SERVICE/entrypoint.sh /deploy/entrypoint.sh
RUN sed -i 's/\r$//' /deploy/entrypoint.sh
RUN cp -r $SERVICE/dist /deploy/dist
RUN rm -rf /deploy/prisma && mkdir -p /deploy/prisma
RUN [ -d $SERVICE/prisma/generated ] && cp -r $SERVICE/prisma/generated /deploy/prisma/generated || true
RUN [ -f $SERVICE/prisma/schema.prisma ] && cp $SERVICE/prisma/schema.prisma /deploy/prisma/schema.prisma || true
RUN [ -d $SERVICE/prisma/migrations ] && cp -r $SERVICE/prisma/migrations /deploy/prisma/migrations || true
RUN [ -f $SERVICE/prisma.config.ts ] && cp $SERVICE/prisma.config.ts /deploy/prisma.config.ts || true
RUN cp tsconfig.base.json /deploy/tsconfig.base.json
RUN sed 's|\.\./tsconfig\.base\.json|./tsconfig.base.json|' $SERVICE/tsconfig.json > /deploy/tsconfig.json

FROM node:22-alpine
LABEL org.opencontainers.image.source=https://github.com/kirillasyamov/backend

RUN apk add --no-cache dumb-init
WORKDIR /app
COPY --from=builder /deploy ./
RUN [ -f prisma/schema.prisma ] && apk add --no-cache postgresql-client || true
USER node
ENTRYPOINT ["dumb-init","--"]
CMD ["sh","/app/entrypoint.sh"]
