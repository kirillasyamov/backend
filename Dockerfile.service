FROM node:22-alpine AS builder

RUN apk add --no-cache yq
RUN corepack enable
WORKDIR /repo

ARG SERVICE

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY $SERVICE/ ./$SERVICE/

RUN yq -i ".packages = [\"$SERVICE\"]" pnpm-workspace.yaml

RUN pnpm install --no-frozen-lockfile --filter $SERVICE
RUN [ -f $SERVICE/prisma/schema.prisma ] && pnpm --filter $SERVICE exec prisma generate || true
RUN pnpm --filter $SERVICE build
RUN pnpm deploy --legacy --filter=$SERVICE /deploy
COPY --chmod=0755 $SERVICE/entrypoint.sh /deploy/entrypoint.sh
RUN cp -r $SERVICE/dist /deploy/dist
RUN [ -d $SERVICE/prisma/generated ] && cp -r $SERVICE/prisma/generated /deploy/prisma/generated || true
RUN [ -f $SERVICE/prisma/schema.prisma ] && cp $SERVICE/prisma/schema.prisma /deploy/prisma/schema.prisma || true
RUN [ -d $SERVICE/prisma/migrations ] && cp -r $SERVICE/prisma/migrations /deploy/prisma/migrations || true
RUN [ -f $SERVICE/prisma.config.ts ] && cp $SERVICE/prisma.config.ts /deploy/prisma.config.ts || true
RUN cp tsconfig.base.json /deploy/tsconfig.base.json
RUN sed 's|\.\./tsconfig\.base\.json|./tsconfig.base.json|' $SERVICE/tsconfig.json > /deploy/tsconfig.json

FROM node:22-alpine
RUN apk add --no-cache dumb-init
WORKDIR /app
COPY --from=builder /deploy ./
RUN [ -f prisma/schema.prisma ] && apk add --no-cache postgresql-client || true
USER node
ENTRYPOINT ["dumb-init","--"]
CMD ["sh","/app/entrypoint.sh"]